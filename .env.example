# Copia este archivo como .env y ajusta los valores a tu entorno.


# Nombre del servidor SQL Server (ej: localhost, DanServer, miservidor\SQLEXPRESS)
DB_SERVIDOR=Desktop-1234567

# Nombre de la base de datos
DB_BASE_DATOS=VentasInventario

# Método de autenticación: "windows" para Windows Auth, "sql" para usuario/contraseña SQL
DB_AUTH=windows

# Solo necesarios si DB_AUTH=sql
# DB_USUARIO=mi_usuario
# DB_PASSWORD=mi_contrasena
